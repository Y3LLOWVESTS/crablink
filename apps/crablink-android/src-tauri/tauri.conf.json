{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrabLink",
  "version": "0.1.0",
  "identifier": "com.rustyonions.crablink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CrabLink",
        "width": 412,
        "height": 915,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
